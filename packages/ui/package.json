{
  "name": "@harvey-withington/folder-templates-ui",
  "version": "0.1.0",
  "description": "Svelte 5 components for Folder Templates: parameter form, preview tree, template editor and authoring tools.",
  "license": "MIT",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./locales/en.json": "./src/locales/en.json",
    "./vite": {
      "types": "./lucide-per-icon.d.ts",
      "default": "./lucide-per-icon.js"
    }
  },
  "files": [
    "src",
    "lucide-per-icon.js",
    "lucide-per-icon.d.ts",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "lucide-svelte": ">=0.400.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@testing-library/user-event": "^14.5.2",
    "@tsconfig/svelte": "^5.0.0",
    "jsdom": "^25.0.1",
    "lucide-svelte": "^0.577.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.1.1"
  }
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/app/frontend" },
      "problemMatcher": []
    },
    {
      "label": "app: build (debug)",
      "detail": "Go build with the Wails dev tag and optimizations off, for Delve",
      // A script rather than an inline command: it also embeds the app icon,
      // and it sidesteps Windows PowerShell re-splitting "all=-N -l".
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/debug-build.ps1"],
      "dependsOn": ["frontend: build"],
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "frontend: dev server",
      "detail": "Vite with hot reload on http://localhost:5174",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/app/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "app: build (debug) + dev server",
      "dependsOn": ["app: build (debug)", "frontend: dev server"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
